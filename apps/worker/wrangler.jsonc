{
  // PANDAM API — Cloudflare Worker configuration.
  //
  // This file describes bindings the Worker will use. Resources are NOT created
  // by anything in this repo — you provision them once with `wrangler` and paste
  // the ids below (or set them per-environment in the Cloudflare dashboard / CI).
  // Placeholders are left as "REPLACE_ME" and every binding block that needs a
  // real resource is commented out so `wrangler dev` runs clean today.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pandam-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true
  },

  // ---------------------------------------------------------------------------
  // Vars — non-secret config. Secrets go in .dev.vars locally (gitignored) and
  // `wrangler secret put` in deployed environments.
  // ---------------------------------------------------------------------------
  "vars": {
    "PANDAM_ENV": "development"
  },

  // ---------------------------------------------------------------------------
  // D1 (Cloudflare D1 + Drizzle ORM). Schema + migrations live in
  // packages/database. The binding is enabled so `wrangler dev` and
  // `wrangler d1 migrations apply pandam-db --local` work against a local
  // SQLite file under .wrangler/ (gitignored) with NO cloud resource.
  //
  // `database_id` is a placeholder: it is ignored for `--local`. Before any
  // remote use, run `wrangler d1 create pandam-db` and paste the real id here
  // (or set it per-environment). Nothing in this repo provisions or deploys.
  // ---------------------------------------------------------------------------
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "pandam-db",
      "database_id": "local-development-placeholder-0000",
      "migrations_dir": "../../packages/database/migrations"
    }
  ],

  // ---------------------------------------------------------------------------
  // R2 (object storage for listing photos and avatars). App -> Worker -> R2;
  // the app never talks to R2 directly and never sees a bucket credential.
  // Create the buckets once with:
  //   wrangler r2 bucket create pandam-media
  //   wrangler r2 bucket create pandam-media-preview
  // Local `wrangler dev` simulates the bucket on disk, so uploads work without
  // creating anything. Without this binding the upload routes return a clear
  // 503 rather than failing halfway through.
  // ---------------------------------------------------------------------------
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "pandam-media",
      "preview_bucket_name": "pandam-media-preview"
    }
  ],

  // ---------------------------------------------------------------------------
  // Durable Objects (realtime: presence, conversation sockets). App -> Worker
  // -> Durable Object -> WebSocket. Class is implemented later.
  // ---------------------------------------------------------------------------
  // "durable_objects": {
  //   "bindings": [
  //     { "name": "CONVERSATION", "class_name": "ConversationRoom" }
  //   ]
  // },
  // "migrations": [
  //   { "tag": "v1", "new_sqlite_classes": ["ConversationRoom"] }
  // ],

  // ---------------------------------------------------------------------------
  // Queues (background jobs: notifications, image post-processing, etc.).
  // Create with:  wrangler queues create pandam-jobs
  // ---------------------------------------------------------------------------
  // "queues": {
  //   "producers": [
  //     { "binding": "JOBS", "queue": "pandam-jobs" }
  //   ],
  //   "consumers": [
  //     {
  //       "queue": "pandam-jobs",
  //       "max_batch_size": 10,
  //       "max_batch_timeout": 5,
  //       "max_retries": 3,
  //       "dead_letter_queue": "pandam-jobs-dlq"
  //     }
  //   ]
  // },

  // ---------------------------------------------------------------------------
  // Named environments. Wrangler does NOT inherit bindings or vars into a named
  // environment, so each one restates everything it needs. Deploy with
  // `wrangler deploy --env staging` (Worker name becomes `pandam-api-staging`).
  // The top-level config above stays the LOCAL development setup.
  //
  // `staging`: a separate Worker, D1 database and R2 bucket so nothing here can
  // touch production data. PANDAM_ENV=preview keeps the demo-only identity
  // verification available for testing; production (added later) must use
  // "production". Secrets are NOT in this file: set them with
  // `wrangler secret put NAME --env staging`.
  // ---------------------------------------------------------------------------
  "env": {
    "staging": {
      "workers_dev": true,
      "vars": {
        "PANDAM_ENV": "preview",
        // Exact browser origins allowed to send credentialed requests. Native apps are not
        // affected by CORS. Fill in only if a web build is served from a staging origin.
        "CORS_ORIGINS": "",
        "RELEASE": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "pandam-db-staging",
          // Filled in from the output of `wrangler d1 create pandam-db-staging`.
          "database_id": "a6d498ca-c729-4065-b7a8-43585363d15c",
          "migrations_dir": "../../packages/database/migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "MEDIA",
          "bucket_name": "pandam-media-staging"
        }
      ]
    }
  }
}
