{
  "name": "@pandam/worker",
  "version": "0.1.0",
  "private": true,
  "description": "PANDAM API — Cloudflare Worker (Hono)",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev --ip 0.0.0.0 --port 8787",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "cf-typegen": "wrangler types",
    "clean": "rm -rf dist .turbo .wrangler coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@pandam/database": "workspace:*",
    "@pandam/types": "workspace:*",
    "@pandam/utils": "workspace:*",
    "@pandam/validation": "workspace:*",
    "hono": "^4.6.16",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260908.1",
    "@libsql/client": "^0.15.15",
    "@pandam/config": "workspace:*",
    "drizzle-orm": "^0.38.3",
    "eslint": "^8.57.1",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8",
    "wrangler": "^4.130.0"
  }
}
