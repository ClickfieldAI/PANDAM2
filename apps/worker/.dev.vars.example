# Copy to apps/worker/.dev.vars (gitignored) for local `wrangler dev`.
# These are LOCAL development values only — never real production secrets.
#
# Authentication needs NOTHING here: password hashing (PBKDF2) and session-token
# hashing (SHA-256) use the Workers runtime's Web Crypto. See
# docs/architecture/auth.md.

# Comma-separated extra browser origins allowed to send credentialed requests.
# The localhost dev origins (3000 / 8081 / 19006) are always allowed.
# CORS_ORIGINS=

# Observability (optional)
SENTRY_DSN=
POSTHOG_KEY=
POSTHOG_HOST=https://us.i.posthog.com

# Razorpay (real-money purchases of `sale`/`both` listings — optional).
# Get test-mode keys from https://dashboard.razorpay.com/app/keys (Test Mode).
# Without these, POST /api/v1/payments returns a clear "not configured" error
# instead of pretending to create a working checkout link.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# From the webhook you register at Settings -> Webhooks -> add
# {API_URL}/api/v1/payments/webhook, subscribed to payment_link.paid and
# payment_link.expired. This is a signing secret, not an API key.
RAZORPAY_WEBHOOK_SECRET=

# Expo push (optional). Only needed once "enhanced push security" is enabled
# for the Expo project; without it, sends to exp.host are unauthenticated and
# still delivered. A notification is always stored in the database first, so a
# missing token here costs the interruption, never the notification.
EXPO_ACCESS_TOKEN=

# "Sign in with Google/Apple" (optional). Not secrets — these are OAuth
# *client* ids, public by design; the real security boundary is the
# provider's signature on the ID token, verified server-side. Without these
# set, POST /api/v1/auth/oauth returns a clear "not configured" error rather
# than accepting a token it cannot verify. See README "Social sign-in" and
# apps/worker/src/lib/oauth.ts.
#
# GOOGLE_OAUTH_CLIENT_IDS: comma-separated — one PANDAM project has a
# separate OAuth client per platform (Web/iOS/Android) in Google Cloud
# Console, and every one of them must be accepted.
GOOGLE_OAUTH_CLIENT_IDS=
# APPLE_OAUTH_AUDIENCES: comma-separated — your iOS bundle id, plus a
# Services ID if you also want Apple sign-in on web.
APPLE_OAUTH_AUDIENCES=

# Platform-fee DEMO tiers (optional). JSON array, amounts in paise, contiguous
# from 1 with an unbounded last tier. Unset = built-in SAMPLE tiers (NOT approved
# commercial rates). Example:
# PLATFORM_FEE_TIERS=[{"label":"Up to ₹500","minAmount":1,"maxAmount":50000,"feeAmount":500,"enabled":true},{"label":"Above ₹500","minAmount":50001,"maxAmount":null,"feeAmount":2000,"enabled":true}]

# Crash reporting (optional). Leave empty to turn reporting off.
# SENTRY_DSN=https://<public-key>@<org>.ingest.sentry.io/<project-id>
# RELEASE=local
