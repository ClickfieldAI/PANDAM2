{
  "name": "@pandam/app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "description": "PANDAM universal app (iOS / Android / Web) — Expo + Expo Router",
  "scripts": {
    "dev": "expo start --port 3000",
    "dev:web": "expo start --web",
    "dev:clear": "expo start --port 3000 --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build": "expo export --platform web --output-dir dist",
    "lint": "eslint \"app/**/*.{ts,tsx}\" \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist .expo .turbo web-build *.tsbuildinfo",
    "dev:tunnel": "expo start --tunnel --clear",
    "dev:client": "expo start --dev-client --clear"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/inter-tight": "^0.4.2",
    "@expo/vector-icons": "^15.0.2",
    "@hookform/resolvers": "^3.9.1",
    "@pandam/types": "workspace:*",
    "@pandam/ui": "workspace:*",
    "@pandam/utils": "workspace:*",
    "@pandam/validation": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@sentry/react-native": "~7.11.0",
    "@tanstack/react-query": "^5.62.11",
    "expo": "~57.0.22",
    "expo-apple-authentication": "~57.0.2",
    "expo-application": "~57.0.3",
    "expo-auth-session": "~57.0.12",
    "expo-blur": "~57.0.3",
    "expo-camera": "~57.0.5",
    "expo-constants": "~57.0.18",
    "expo-crypto": "~57.0.3",
    "expo-dev-client": "~57.0.19",
    "expo-device": "~57.0.2",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-image": "~57.0.5",
    "expo-image-picker": "~57.0.17",
    "expo-linear-gradient": "~57.0.2",
    "expo-linking": "~57.0.10",
    "expo-localization": "~57.0.2",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.18",
    "expo-router": "~57.0.21",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "expo-video-thumbnails": "~57.0.2",
    "expo-web-browser": "~57.0.3",
    "lottie-react-native": "~7.3.8",
    "nativewind": "^4.2.6",
    "posthog-react-native": "^3.3.11",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.54.2",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.2",
    "react-native-worklets": "0.10.1",
    "zod": "^3.24.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@pandam/config": "workspace:*",
    "@types/react": "~19.2.18",
    "eslint": "^8.57.1",
    "eslint-config-expo": "~57.0.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
