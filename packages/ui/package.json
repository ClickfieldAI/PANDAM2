{
  "name": "@pandam/ui",
  "version": "0.1.0",
  "private": true,
  "description": "Cross-platform (iOS/Android/Web) UI foundation for PANDAM",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens": "./src/tokens.ts"
  },
  "scripts": {
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "test": "echo \"@pandam/ui: no tests yet\"",
    "clean": "rm -rf dist .turbo *.tsbuildinfo"
  },
  "dependencies": {
    "@pandam/utils": "workspace:*"
  },
  "peerDependencies": {
    "expo-haptics": ">=57",
    "expo-linear-gradient": ">=57",
    "nativewind": ">=4.2",
    "react": ">=19",
    "react-native": ">=0.81",
    "react-native-reanimated": ">=4"
  },
  "devDependencies": {
    "@pandam/config": "workspace:*",
    "@types/react": "~19.2.18",
    "eslint": "^8.57.1",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-reanimated": "4.5.1",
    "typescript": "^6.0.3"
  }
}
